{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "clandestiny",
  "main": "src/index.tsx",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },

  // Bundle migrations/*.sql as text so the Worker can apply them itself (src/migrate.ts).
  "rules": [{ "type": "Text", "globs": ["**/*.sql"], "fallthrough": true }],

  // CSS, icons and other public files. Served without sign-in, so never put
  // family data or photos here (those will live in R2 behind the login).
  "assets": { "directory": "./public" },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "clandestiny",
      // The D1 database created in the Cloudflare dashboard.
      "database_id": "e9871af6-12d6-4a3e-a346-329c6a7e204c",
      "migrations_dir": "migrations"
    }
  ],

  "vars": {
    // Shown in the header, page titles and emails.
    "SITE_NAME": "Clan Destiny",
    // Who sign-in emails come from. The domain must be verified in Resend.
    "EMAIL_FROM": "Clan Destiny <stories@clandestiny.us>"
  }

  // Set these as secrets in Cloudflare, never in this file:
  //   npx wrangler secret put ADMIN_EMAILS     comma-separated; can sign in without
  //                                            an invite and become admins
  //   npx wrangler secret put RESEND_API_KEY   for sending sign-in emails
}
